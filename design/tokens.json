{
  "$description": "Pax design tokens. One source for every color, radius and type size (SPEC: Design tokens). `npm run tokens` generates packages/tokens/src/generated/*. Light values come from SPEC.md and the Next Screens canvas; dark neutrals are derived for the dark theme.",
  "version": 1,
  "color": {
    "neutral": {
      "light": {
        "background": "#FFFFFF",
        "surface": "#FFFFFF",
        "surfaceMuted": "#F7F7F7",
        "locked": "#F2F2F2",
        "border": "#E5E5E5",
        "divider": "#ECECEC",
        "text": "#3C3C3C",
        "textMuted": "#6B6B6B",
        "textSubtle": "#AFAFAF",
        "paxShadow": "#E6ECF2"
      },
      "dark": {
        "background": "#10171C",
        "surface": "#17222A",
        "surfaceMuted": "#1D2A33",
        "locked": "#22303A",
        "border": "#2E3D47",
        "divider": "#24323B",
        "text": "#EEF2F5",
        "textMuted": "#A3B1BA",
        "textSubtle": "#6F808B",
        "paxShadow": "#22303A"
      }
    },
    "game": {
      "streak": "#FF9F1C",
      "streakText": "#F08A00",
      "streakLight": "#FFD25E",
      "xp": "#FFC107",
      "xpText": "#D99A00",
      "review": "#2FA4E7",
      "reviewText": "#1E88C8",
      "reviewLight": "#7CC6F2",
      "correct": "#58A700",
      "correctBackground": "#D7FFB8",
      "incorrect": "#EA2B2B",
      "incorrectBackground": "#FFDFE0",
      "incorrectButton": "#C81E1E"
    },
    "liturgical": {
      "$description": "Accent and raised edge per SPEC table. Tint = accent mixed toward the background (88% toward white in light). Text-on-accent from SPEC.",
      "green": {
        "label": "Green",
        "light": { "accent": "#24913C", "edge": "#1B6E2E", "onAccent": "#FFFFFF" },
        "dark": { "accent": "#2EA84A", "edge": "#238038", "onAccent": "#FFFFFF" }
      },
      "violet": {
        "label": "Violet",
        "light": { "accent": "#7C4DDB", "edge": "#5E3AA6", "onAccent": "#FFFFFF" },
        "dark": { "accent": "#8E5CF6", "edge": "#6C46BB", "onAccent": "#FFFFFF" }
      },
      "rose": {
        "label": "Rose",
        "light": { "accent": "#C2185B", "edge": "#931245", "onAccent": "#FFFFFF" },
        "dark": { "accent": "#D63A73", "edge": "#A32C58", "onAccent": "#FFFFFF" }
      },
      "white": {
        "label": "White and gold",
        "light": { "accent": "#F2B705", "edge": "#B88B04", "onAccent": "#3B2A00" },
        "dark": { "accent": "#F2B705", "edge": "#B88B04", "onAccent": "#3B2A00" }
      },
      "red": {
        "label": "Red",
        "light": { "accent": "#D12F33", "edge": "#9F2427", "onAccent": "#FFFFFF" },
        "dark": { "accent": "#E0474B", "edge": "#AA3639", "onAccent": "#FFFFFF" }
      },
      "black": {
        "label": "Black",
        "light": { "accent": "#3C3C3C", "edge": "#1F1F1F", "onAccent": "#FFFFFF" },
        "dark": { "accent": "#6E6E6E", "edge": "#535353", "onAccent": "#FFFFFF" }
      }
    },
    "derive": {
      "tintLight": 0.88,
      "tintDark": 0.78,
      "accentTextDarkTowardWhite": 0.35
    },
    "pax": {
      "body": "#F5F8FC",
      "shade": "#E4ECF5",
      "wing": "#DCE6F1",
      "wingDeep": "#C5D3E3",
      "belly": "#FFFFFF",
      "eye": "#1E2633",
      "beak": "#FFB347",
      "beakDeep": "#F28C28",
      "mouth": "#E0701B",
      "tongue": "#FF7A8A",
      "blush": "#FFB9C6",
      "blushHappy": "#FFA3B5",
      "feet": "#F28C28",
      "olive": "#7FA650",
      "oliveDeep": "#5E8A3A",
      "oliveSeed": "#3F5F27"
    }
  },
  "font": {
    "family": {
      "ui": "Nunito",
      "scripture": "Source Serif 4"
    },
    "weight": { "bold": 700, "extraBold": 800, "black": 900 },
    "size": {
      "label": 13,
      "small": 14,
      "body": 15,
      "bodyLarge": 16,
      "button": 17,
      "scripture": 18,
      "title": 20,
      "headline": 22,
      "display": 26,
      "hero": 32
    },
    "letterSpacing": { "label": 0.06, "button": 0.06, "chip": 0.04 }
  },
  "radius": {
    "chip": 10,
    "tile": 14,
    "button": 16,
    "card": 18,
    "panel": 20,
    "hero": 22,
    "round": 999
  },
  "border": { "width": 2 },
  "edge": { "card": 4, "button": 5, "hero": 6 },
  "space": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 16, "xxl": 20, "screen": 16 },
  "size": {
    "tabIcon": 30,
    "tabBarHeight": 64,
    "buttonHeight": 54,
    "buttonHeightSmall": 50,
    "rowHeight": 52,
    "pathNode": 80,
    "progressBar": 16
  }
}
