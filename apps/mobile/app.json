{
  "expo": {
    "name": "Pax",
    "slug": "pax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paxapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.benbrunson.pax",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.benbrunson.pax"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.benbrunson.pax",
      "adaptiveIcon": {
        "backgroundColor": "#21923E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#10171C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#24913C"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.benbrunson.pax.widgets",
          "groupIdentifier": "group.com.benbrunson.pax",
          "widgets": [
            {
              "name": "PaxToday",
              "displayName": "Today",
              "description": "Your streak and today's Read, Pray and Study.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "PaxPrayer",
              "displayName": "Prayer",
              "description": "A prayer for this hour of the day, or today's Rosary.",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryRectangular"],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Prayer",
                  "description": "Choose what the widget shows.",
                  "parameters": {
                    "mode": {
                      "title": "Show",
                      "type": "enum",
                      "default": "now",
                      "values": [
                        {
                          "name": "A prayer for this hour",
                          "value": "now"
                        },
                        {
                          "name": "Today's Rosary",
                          "value": "rosary"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "PaxWord",
              "displayName": "Word for today",
              "description": "The verse or saying from the Today screen.",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "PaxWeek",
              "displayName": "Week",
              "description": "This week's liturgical colors, your streak and the next feast.",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "d16e0080-33a4-448b-8b29-6fe0e0c4dd9c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d16e0080-33a4-448b-8b29-6fe0e0c4dd9c"
    }
  }
}
